  SystemCallAccess:
    ControlMemory: 1
    QueryMemory: 2
    ExitProcess: 3
    CreateThread: 8
    ExitThread: 9
    SleepThread: 10
    CreateMutex: 19
    ReleaseMutex: 20
    CreateSemaphore: 21
    ReleaseSemaphore: 22
    CreateEvent: 23
    SignalEvent: 24
    ClearEvent: 25
    CreateTimer: 26
    SetTimer: 27
    CancelTimer: 28
    ClearTimer: 29
    CloseHandle: 35
    WaitSynchronization1: 36
    WaitSynchronizationN: 37
    SignalAndWait: 38
    DuplicateHandle: 39
    GetSystemTick: 40
    GetHandleInfo: 41
    GetSystemInfo: 42
    GetProcessInfo: 43
    ConnectToPort: 45
    SendSyncRequest: 50
  FileSystemAccess:
    - "CategorySystemApplication"
    - "DirectSdmc"
  ServiceAccessControl:
    # Existing graphics, SD config, Wi-Fi, input, and NEWS initialization.
    - "APT:U"
    - "ac:u"
    - "cfg:u"
    - "fs:USER"
    - "gsp::Gpu"
    - "gsp::Lcd"
    - "hid:USER"
